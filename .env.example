# Copy this file to .env (gitignored) and put your real key there. Never commit .env.
#
# API key for testing API mode only (console.anthropic.com > API Keys).
# The name is deliberately NOT ANTHROPIC_API_KEY: if this file is ever loaded into a
# shell by mistake, Claude Code won't switch that shell from your subscription to the API.
# Export it as ANTHROPIC_API_KEY only in the one terminal you test API mode in.
CMR_TEST_API_KEY=replace-with-your-key
