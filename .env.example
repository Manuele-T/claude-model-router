# Copy this file to .env (gitignored) and put your real key there. Never commit .env.
#
# API key for testing API mode (console.anthropic.com > API Keys).
# Claude Code bills this key instead of your subscription wherever it is set, so load it
# only in the one terminal you test API mode in, never in your shell startup files.
ANTHROPIC_API_KEY=replace-with-your-key
